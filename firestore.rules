rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'agrifarmadmin@gmail.com' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'Customer') == 'Admin'
      );
    }

    function isFarmer() {
      return isSignedIn() &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'Customer') == 'Farmer';
    }

    function isDeliveryPerson() {
      return isSignedIn() &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'Customer') == 'Delivery Person';
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || request.auth.uid == userId;
      match /{allSubcollections=**} {
        allow read, write: if isAdmin() || request.auth.uid == userId;
      }
    }

    match /farmers/{userId} {
      allow read, write: if isAdmin() || request.auth.uid == userId;
      allow read: if isSignedIn();
    }

    match /riders/{userId} {
      allow read, write: if isAdmin() || request.auth.uid == userId;
      allow read: if isSignedIn();
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
      allow create: if isFarmer();
      allow update, delete: if isFarmer() && (resource.data.farmerUid == request.auth.uid);
    }

    match /categories/{catId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /research_submissions/{submissionId} {
      allow read, write: if isAdmin();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /orders/{orderId} {
      allow create: if isSignedIn();
      allow read, write: if isAdmin();
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        resource.data.deliveryId == request.auth.uid ||
        resource.data.farmerUid == request.auth.uid ||
        isFarmer() ||
        isDeliveryPerson()
      );
      allow update: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        resource.data.farmerUid == request.auth.uid ||
        (isDeliveryPerson() && (
          !('deliveryId' in resource.data) ||
          resource.data.deliveryId == "" ||
          resource.data.deliveryId == null ||
          resource.data.deliveryId == request.auth.uid
        ))
      );
    }

    match /{path=**} {
      allow read, write: if isAdmin();
    }
  }
}