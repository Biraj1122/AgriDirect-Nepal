rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---
    function isSignedIn() { return request.auth != null; }

    function userExists() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'agrifarmadmin@gmail.com' ||
        (userExists() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'Customer') == 'Admin')
      );
    }

    function isFarmer() {
      return isSignedIn() && userExists() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'Customer') == 'Farmer';
    }

    function isDeliveryPerson() {
      return isSignedIn() && userExists() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'Customer') == 'Delivery Person';
    }

    // Users collection
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      // Prevent role escalation: users cannot create themselves as Admin or change their role to Admin
      allow create: if isSignedIn() && request.auth.uid == userId &&
                    request.resource.data.get('role', 'Customer') != 'Admin';
      allow update: if isSignedIn() && (
        isAdmin() ||
        (request.auth.uid == userId && request.resource.data.get('role', resource.data.get('role', 'Customer')) == resource.data.get('role', 'Customer'))
      );

      // Notifications subcollection
      match /notifications/{notificationId} {
        allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
        allow write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      }
    }

    // --- FARMER & RIDER DATA ---
    match /farmers/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }
    match /riders/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    // --- PRODUCTS (Farmer Access) ---
    match /products/{productId} {
      allow read: if true;
      allow create: if isFarmer() || isAdmin();
      allow update, delete: if (isFarmer() && resource.data.farmerUid == request.auth.uid) || isAdmin();
    }

    // --- ORDERS ---
    match /orders/{orderId} {
      allow create: if isSignedIn();
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        resource.data.farmerUid == request.auth.uid ||
        resource.data.deliveryId == request.auth.uid ||
        (isDeliveryPerson() && (resource.data.deliveryId == null || resource.data.deliveryId == "")) ||
        isAdmin()
      );
      allow update: if isSignedIn() && (
        isAdmin() ||
        resource.data.userId == request.auth.uid ||
        resource.data.farmerUid == request.auth.uid ||
        resource.data.deliveryId == request.auth.uid ||
        (isDeliveryPerson() && (resource.data.deliveryId == null || resource.data.deliveryId == "" || resource.data.deliveryId == request.auth.uid))
      );
      allow delete: if isAdmin();
    }

    // --- DELIVERY ALERTS ---
    match /delivery_alerts/{alertId} {
      allow read: if isDeliveryPerson() || isAdmin();
      allow create: if isFarmer() || isAdmin();
      allow update, delete: if isAdmin();
    }

    // Products (Master Catalog)
    match /master_catalog/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Settings (Announcements)
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Research Submissions
    match /research_submissions/{submissionId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // Price Update Requests
    match /price_requests/{requestId} {
      allow read: if isSignedIn() && (resource.data.farmerUid == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.farmerUid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /categories/{catId} { allow read: if true; allow write: if isAdmin(); }

    // Scan History
    match /scan_history/{id} {
      allow read, write: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn();
    }

    match /{path=**} { allow read, write: if isAdmin(); }
  }
}
