rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userExists() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'agrifarmadmin@gmail.com' ||
        (userExists() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'Customer') == 'Admin')
      );
    }

    function isFarmer() {
      return isSignedIn() && userExists() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'Customer') == 'Farmer';
    }

    function isDeliveryPerson() {
      return isSignedIn() && userExists() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'Customer') == 'Delivery Person';
    }

    // --- USERS ---
    match /users/{userId} {
      allow read: if isSignedIn() && (
        request.auth.uid == userId ||
        isAdmin() ||
        get(/databases/$(database)/documents/users/$(userId)).data.get('role', 'Customer') == 'Farmer' ||
        get(/databases/$(database)/documents/users/$(userId)).data.get('role', 'Customer') == 'Delivery Person'
      );

      allow create: if isSignedIn() && request.auth.uid == userId &&
                    (request.resource.data.get('role', 'Customer') != 'Admin' || request.auth.token.email == 'agrifarmadmin@gmail.com');

      allow update: if isSignedIn() && (
        isAdmin() ||
        (request.auth.uid == userId && request.resource.data.get('role', resource.data.get('role', 'Customer')) == resource.data.get('role', 'Customer'))
      );

      match /notifications/{notificationId} {
        allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
        allow create: if isSignedIn();
        allow update, delete: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      }

      match /favorites/{favoriteId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    // --- FARMER & RIDER DATA ---
    match /farmers/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }
    match /riders/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    // --- PRODUCTS & CATALOG ---
    match /products/{productId} {
      allow read: if true;
      allow create: if isFarmer() || isAdmin();
      allow update, delete: if (isFarmer() && resource.data.farmerUid == request.auth.uid) || isAdmin();
    }
    match /master_catalog/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- ORDERS ---
    match /orders/{orderId} {
      allow create: if isSignedIn();
      allow read: if isSignedIn() && (
        isAdmin() ||
        resource.data.userId == request.auth.uid ||
        resource.data.farmerUid == request.auth.uid ||
        resource.data.deliveryId == request.auth.uid ||
        resource.data.deliveryPersonId == request.auth.uid ||
        (isDeliveryPerson() && (resource.data.status in ['Awaiting Pickup', 'Picked Up', 'On the way', 'Arrived'] || resource.data.deliveryId == null || resource.data.deliveryId == "")) ||
        (isFarmer() && (resource.data.status == 'Pending Farmer' || resource.data.farmerUid == request.auth.uid))
      );
      allow update: if isSignedIn() && (
        isAdmin() ||
        resource.data.userId == request.auth.uid ||
        resource.data.farmerUid == request.auth.uid ||
        resource.data.deliveryId == request.auth.uid ||
        resource.data.deliveryPersonId == request.auth.uid ||
        (isFarmer() && resource.data.status == 'Pending Farmer') ||
        (isDeliveryPerson() && resource.data.status in ['Awaiting Pickup', 'Picked Up', 'On the way', 'Arrived']) ||
        (isDeliveryPerson() && (resource.data.deliveryId == null || resource.data.deliveryId == "") && request.resource.data.deliveryId == request.auth.uid)
      );
      allow delete: if isAdmin();
    }

    // --- MISC ---
    match /price_requests/{requestId} {
      allow read: if isAdmin() || (isFarmer() && resource.data.farmerUid == request.auth.uid);
      allow create: if isFarmer();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    match /delivery_alerts/{alertId} {
      allow read: if isDeliveryPerson() || isAdmin();
      allow create: if isFarmer() || isAdmin();
      allow update, delete: if isAdmin();
    }
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /research_submissions/{submissionId} {
      allow read: if isAdmin();
      allow create: if isFarmer();
    }
  }
}
